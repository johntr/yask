[Desktop Entry]
Name=Steam Games
GenericName=Steam Game Launcher
Comment=yask — launch Steam games by name, including ones you haven't installed
Icon=steam
Type=Service
X-KDE-ServiceTypes=Plasma/Runner
X-KDE-PluginInfo-Name=yask
X-KDE-PluginInfo-Author=John Redlich
X-KDE-PluginInfo-Website=https://github.com/johntr/yask
X-KDE-PluginInfo-Version=1.2
X-KDE-PluginInfo-License=MIT
X-KDE-PluginInfo-Category=Games
X-KDE-PluginInfo-EnabledByDefault=true
X-Plasma-API=DBus2
X-Plasma-DBusRunner-Service=io.github.johntr.yask
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Request-Actions-Once=true
X-Plasma-Runner-Syntaxes=:q:,steam :q:
X-Plasma-Runner-Syntax-Descriptions=Finds installed Steam games matching :q:,Lists Steam games and Steam's own screens matching :q:
